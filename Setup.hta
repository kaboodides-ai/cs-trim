<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>CS Trim - התקנה ל-Adobe Premiere Pro</title>
    <HTA:APPLICATION 
        ID="CSTrimSetup"
        APPLICATIONNAME="CS Trim Installer"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="no"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
        SCROLL="no"
        ICON="img/logo.ico"
    />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            background-color: #0c0d12;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            direction: rtl;
            text-align: right;
            user-select: none;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }
        .container {
            padding: 24px;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }
        .header {
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 16px;
            margin-bottom: 18px;
        }
        .logo-box {
            width: 48px;
            height: 48px;
            background: #2563eb;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 14px;
            flex-shrink: 0;
            overflow: hidden;
        }
        .logo-box img {
            width: 36px;
            height: 36px;
            object-fit: contain;
        }
        .header-text h1 {
            font-size: 19px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 2px;
        }
        .header-text .subtitle {
            font-size: 12px;
            color: #94a3b8;
        }
        .content {
            flex: 1;
        }
        .info-card {
            background: #141721;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 14px;
            font-size: 13px;
            line-height: 1.6;
            color: #cbd5e1;
        }
        .info-card strong {
            color: #60a5fa;
        }
        .notice-warn {
            background: rgba(245, 158, 11, 0.12);
            border-right: 3px solid #f59e0b;
            padding: 10px 12px;
            border-radius: 0 6px 6px 0;
            font-size: 12px;
            color: #fde68a;
            margin-top: 10px;
            display: none;
        }
        .status-msg {
            font-size: 13px;
            color: #60a5fa;
            font-weight: 600;
            display: none;
            margin-top: 12px;
        }
        .progress-bar {
            width: 100%;
            height: 6px;
            background: #1e2230;
            border-radius: 3px;
            overflow: hidden;
            display: none;
            margin-top: 10px;
        }
        .progress-fill {
            height: 100%;
            width: 0%;
            background: #2563eb;
            transition: width 0.3s;
        }
        .footer-btns {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }
        .btn {
            padding: 10px 24px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            border: none;
            outline: none;
            font-family: inherit;
        }
        .btn-primary {
            background: #2563eb;
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
        }
        .btn-primary:hover {
            background: #1d4ed8;
        }
        .btn-secondary {
            background: #1e2230;
            color: #94a3b8;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .btn-secondary:hover {
            background: #282e42;
            color: white;
        }
        .success-box {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 10px;
            padding: 18px;
            font-size: 13px;
            line-height: 1.6;
        }
        .success-title {
            color: #34d399;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .menu-path {
            background: #090a0f;
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: 10px 14px;
            border-radius: 6px;
            margin-top: 10px;
            color: #60a5fa;
            font-weight: 700;
            font-size: 14px;
            text-align: center;
            direction: ltr;
        }
    </style>
</head>
<body onload="initApp();">
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="logo-box">
                <img src="img/logo.png" alt="CS" onerror="this.style.display='none';">
            </div>
            <div class="header-text">
                <h1>התקנת CS Trim</h1>
                <div class="subtitle">תוסף חיתוך שקט וכתוביות AI עבור Adobe Premiere Pro</div>
            </div>
        </div>

        <!-- Main Step -->
        <div class="content" id="stepMain">
            <div class="info-card">
                אשף זה יתקין את תוסף <strong>CS Trim</strong> ישירות לתיקיית ההרחבות של אדובי ויגדיר אוטומטית את הרשאות הפיתוח של פרמייר.
                <div class="notice-warn" id="warnPremiereOpen">
                    ⚠️ <strong>שים לב:</strong> Adobe Premiere Pro פועלת כעת ברקע. יש לסגור ולפתוח אותה מחדש לאחר ההתקנה כדי שהתוסף ייטען.
                </div>
            </div>

            <div class="status-msg" id="statusMsg">מתקין קבצים...</div>
            <div class="progress-bar" id="pBar">
                <div class="progress-fill" id="pFill"></div>
            </div>
        </div>

        <!-- Success Step -->
        <div class="content" id="stepSuccess" style="display: none;">
            <div class="success-box">
                <div class="success-title">🎉 ההתקנה הושלמה בהצלחה!</div>
                <p>התוסף הועתק לתיקיית ההרחבות של אדובי והרשאות ה-Registry הופעלו בהצלחה.</p>
                <div style="margin-top: 10px; color: #f8fafc; font-weight: 600;">
                    סגור ופתח מחדש את Premiere Pro, והיכנס ל:
                </div>
                <div class="menu-path">
                    Window &gt; Extensions &gt; CS Trim
                </div>
                <div style="font-size: 11px; color: #94a3b8; text-align: center; margin-top: 4px;">
                    (בעברית בתפריט העליון: חלון &gt; הרחבות &gt; CS Trim)
                </div>
            </div>
        </div>

        <!-- Footer Buttons -->
        <div class="footer-btns" id="footerMain">
            <button class="btn btn-secondary" onclick="window.close();" id="btnCancel">ביטול</button>
            <button class="btn btn-primary" onclick="startInstall();" id="btnInstall">התקן עכשיו</button>
        </div>

        <div class="footer-btns" id="footerSuccess" style="display: none;">
            <button class="btn btn-primary" onclick="window.close();">סיום</button>
        </div>
    </div>

    <script>
        function initApp() {
            try {
                window.resizeTo(520, 420);
                window.moveTo((screen.width - 520) / 2, (screen.height - 420) / 2);
            } catch(e) {}

            try {
                if (isPremiereRunning()) {
                    document.getElementById("warnPremiereOpen").style.display = "block";
                }
            } catch(e) {}
        }

        function isPremiereRunning() {
            try {
                var locator = new ActiveXObject("WbemScripting.SWbemLocator");
                var service = locator.ConnectServer(".", "root\\cimv2");
                var procs = service.ExecQuery("Select Name from Win32_Process Where Name = 'Adobe Premiere Pro.exe' or Name = 'Premiere.exe'");
                return (procs.Count > 0);
            } catch(e) {
                return false;
            }
        }

        function getBaseDirectory(fso, shell) {
            var p = window.location.pathname;
            if (p.charAt(0) === '/' || p.charAt(0) === '\\') {
                p = p.substring(1);
            }
            p = decodeURIComponent(p).replace(/\//g, "\\");

            var dir = "";
            try { dir = fso.GetParentFolderName(p); } catch(e) {}
            if (dir && fso.FolderExists(dir)) {
                return dir;
            }

            try {
                var cmd = CSTrimSetup.commandLine;
                cmd = cmd.replace(/^"/, "").replace(/"$/, "");
                var cmdDir = fso.GetParentFolderName(cmd);
                if (cmdDir && fso.FolderExists(cmdDir)) return cmdDir;
            } catch(e) {}

            return shell.CurrentDirectory;
        }

        function findSourceFolder(fso, baseDir) {
            // Check 1: subfolder com.autocut.panel
            var c1 = baseDir + "\\com.autocut.panel";
            if (fso.FolderExists(c1) && fso.FileExists(c1 + "\\CSXS\\manifest.xml")) {
                return c1;
            }

            // Check 2: baseDir has CSXS/manifest.xml
            if (fso.FileExists(baseDir + "\\CSXS\\manifest.xml")) {
                return baseDir;
            }

            // Check 3: parent dir has com.autocut.panel
            try {
                var parentDir = fso.GetParentFolderName(baseDir);
                var c3 = parentDir + "\\com.autocut.panel";
                if (fso.FolderExists(c3) && fso.FileExists(c3 + "\\CSXS\\manifest.xml")) {
                    return c3;
                }
            } catch(e) {}

            return null;
        }

        function createFolderRecursive(fso, folderPath) {
            if (fso.FolderExists(folderPath)) return;
            var parent = fso.GetParentFolderName(folderPath);
            if (parent && !fso.FolderExists(parent)) {
                createFolderRecursive(fso, parent);
            }
            try {
                fso.CreateFolder(folderPath);
            } catch(e) {}
        }

        function copyFilesClean(fso, srcDir, dstDir) {
            createFolderRecursive(fso, dstDir);
            var items = ["CSXS", "css", "host", "img", "js", "index.html", ".debug", "bin"];
            for (var i = 0; i < items.length; i++) {
                var item = items[i];
                var s = srcDir + "\\" + item;
                var d = dstDir + "\\" + item;
                if (fso.FolderExists(s)) {
                    if (fso.FolderExists(d)) {
                        try { fso.DeleteFolder(d, true); } catch(e) {}
                    }
                    fso.CopyFolder(s, d, true);
                } else if (fso.FileExists(s)) {
                    if (fso.FileExists(d)) {
                        try { fso.DeleteFile(d, true); } catch(e) {}
                    }
                    fso.CopyFile(s, d, true);
                }
            }
        }

        function startInstall() {
            var btnInstall = document.getElementById("btnInstall");
            var btnCancel = document.getElementById("btnCancel");
            var pBar = document.getElementById("pBar");
            var pFill = document.getElementById("pFill");
            var statusMsg = document.getElementById("statusMsg");

            btnInstall.disabled = true;
            btnCancel.disabled = true;
            pBar.style.display = "block";
            statusMsg.style.display = "block";
            statusMsg.innerText = "מאתר קבצי תוסף...";
            pFill.style.width = "30%";

            setTimeout(function() {
                try {
                    var fso = new ActiveXObject("Scripting.FileSystemObject");
                    var shell = new ActiveXObject("WScript.Shell");

                    var baseDir = getBaseDirectory(fso, shell);
                    var srcDir = findSourceFolder(fso, baseDir);

                    if (!srcDir) {
                        throw new Error("לא נמצאה תיקיית התוסף com.autocut.panel. אנא ודא שחילצת את כל קבצי ה-ZIP.");
                    }

                    statusMsg.innerText = "מעתיק קבצים לתיקיות ההרחבה של פרמייר...";
                    pFill.style.width = "60%";

                    // 1. User AppData (Always writable)
                    var appData = shell.ExpandEnvironmentStrings("%APPDATA%");
                    var userTarget = appData + "\\Adobe\\CEP\\extensions\\com.autocut.panel";
                    copyFilesClean(fso, srcDir, userTarget);

                    // 2. Common Program Files (x86)
                    try {
                        var common86 = shell.ExpandEnvironmentStrings("%COMMONPROGRAMFILES(x86)%");
                        if (common86 && common86.indexOf("%") === -1) {
                            var sysTarget86 = common86 + "\\Adobe\\CEP\\extensions\\com.autocut.panel";
                            copyFilesClean(fso, srcDir, sysTarget86);
                        }
                    } catch(e) {}

                    // 3. Common Program Files (64-bit)
                    try {
                        var common = shell.ExpandEnvironmentStrings("%COMMONPROGRAMFILES%");
                        if (common && common.indexOf("%") === -1) {
                            var sysTarget = common + "\\Adobe\\CEP\\extensions\\com.autocut.panel";
                            copyFilesClean(fso, srcDir, sysTarget);
                        }
                    } catch(e) {}

                    statusMsg.innerText = "מגדיר הרשאות מערכת ו-Registry...";
                    pFill.style.width = "85%";

                    // Write PlayerDebugMode for CSXS versions 7 through 20
                    for (var v = 7; v <= 20; v++) {
                        try {
                            shell.RegWrite("HKCU\\Software\\Adobe\\CSXS." + v + "\\PlayerDebugMode", "1", "REG_SZ");
                        } catch(e) {}
                        try {
                            shell.RegWrite("HKLM\\Software\\Adobe\\CSXS." + v + "\\PlayerDebugMode", "1", "REG_SZ");
                        } catch(e) {}
                        try {
                            shell.RegWrite("HKLM\\Software\\WOW6432Node\\Adobe\\CSXS." + v + "\\PlayerDebugMode", "1", "REG_SZ");
                        } catch(e) {}
                    }

                    pFill.style.width = "100%";
                    statusMsg.innerText = "ההתקנה הושלמה!";

                    setTimeout(function() {
                        document.getElementById("stepMain").style.display = "none";
                        document.getElementById("footerMain").style.display = "none";
                        document.getElementById("stepSuccess").style.display = "block";
                        document.getElementById("footerSuccess").style.display = "flex";
                    }, 400);

                } catch(e) {
                    alert("שגיאה במהלך ההתקנה: " + e.message + "\n\nבאפשרותך להעתיק את תיקיית com.autocut.panel ידנית לתיקיית Adobe\\CEP\\extensions.");
                    btnInstall.disabled = false;
                    btnCancel.disabled = false;
                    pBar.style.display = "none";
                    statusMsg.style.display = "none";
                }
            }, 300);
        }
    </script>
</body>
</html>

