<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>CS Trim - התקנה ל-Adobe Premiere Pro</title>
    <HTA:APPLICATION 
        ID="CSTrimSetup"
        APPLICATIONNAME="CS Trim Installer"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="no"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
        SCROLL="no"
        ICON="img/logo.ico"
    />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            background-color: #0b0f19;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            direction: rtl;
            text-align: right;
            user-select: none;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }
        .container {
            padding: 24px;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }
        .header {
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 16px;
            margin-bottom: 16px;
        }
        .logo-box {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 14px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
        }
        .logo-box img {
            width: 36px;
            height: 36px;
            object-fit: contain;
        }
        .header-text {
            flex: 1;
        }
        .header-text h1 {
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 2px;
        }
        .header-text .subtitle {
            font-size: 12px;
            color: #94a3b8;
        }
        .trust-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }
        .content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .card {
            background: #131b2e;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 18px;
            font-size: 13px;
            line-height: 1.6;
            color: #cbd5e1;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }
        .card-lead {
            font-size: 14px;
            color: #f1f5f9;
            margin-bottom: 12px;
        }
        .features-list {
            margin: 10px 0;
            padding: 0;
            list-style: none;
        }
        .features-list li {
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            color: #cbd5e1;
            font-size: 12.5px;
        }
        .features-list li .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #38bdf8;
            margin-left: 8px;
            flex-shrink: 0;
        }
        .tip-card {
            background: rgba(59, 130, 246, 0.1);
            border-right: 3px solid #3b82f6;
            border-radius: 0 8px 8px 0;
            padding: 10px 14px;
            font-size: 12px;
            color: #bfdbfe;
            margin-top: 12px;
            display: none;
            line-height: 1.5;
        }
        .status-msg {
            font-size: 13px;
            color: #60a5fa;
            font-weight: 600;
            display: none;
            margin-top: 14px;
            text-align: center;
        }
        .progress-bar {
            width: 100%;
            height: 8px;
            background: #1e293b;
            border-radius: 4px;
            overflow: hidden;
            display: none;
            margin-top: 10px;
        }
        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #2563eb, #38bdf8);
            border-radius: 4px;
            transition: width 0.3s;
        }
        .success-box {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.25);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }
        .success-title {
            color: #34d399;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .success-desc {
            font-size: 13px;
            color: #cbd5e1;
            margin-bottom: 14px;
        }
        .guide-box {
            background: #090d16;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 12px 16px;
            text-align: right;
        }
        .guide-step {
            font-size: 12.5px;
            color: #e2e8f0;
            margin-bottom: 6px;
        }
        .menu-path {
            background: #1e293b;
            border: 1px solid #3b82f6;
            padding: 8px 12px;
            border-radius: 6px;
            margin: 6px 0;
            color: #60a5fa;
            font-weight: 700;
            font-size: 13.5px;
            text-align: center;
            direction: ltr;
        }
        .menu-hebrew-hint {
            font-size: 11px;
            color: #94a3b8;
            text-align: center;
        }
        .error-card {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            padding: 12px;
            color: #fca5a5;
            font-size: 12px;
            margin-top: 10px;
            display: none;
            line-height: 1.5;
        }
        .footer-btns {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }
        .btn {
            padding: 10px 22px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            border: none;
            outline: none;
            font-family: inherit;
        }
        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
        }
        .btn-secondary {
            background: #1e293b;
            color: #94a3b8;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .btn-secondary:hover {
            background: #334155;
            color: white;
        }
    </style>
</head>
<body onload="initApp();">
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="logo-box">
                <img src="img/logo.png" alt="CS Trim" onerror="this.style.display='none';">
            </div>
            <div class="header-text">
                <h1>התקנת תוסף CS Trim</h1>
                <div class="subtitle">עריכת וידאו חכמה וכתוביות AI ל-Adobe Premiere Pro</div>
            </div>
            <div class="trust-badge">
                ✓ מאושר ובטוח
            </div>
        </div>

        <!-- Main Step -->
        <div class="content" id="stepMain">
            <div class="card">
                <div class="card-lead">
                    ברוכים הבאים! אשף זה יתקין עבורכם את <strong>CS Trim</strong> ישירות ב-Premiere Pro בלחיצה אחת פשוטה.
                </div>
                <ul class="features-list">
                    <li><span class="dot"></span>חיתוך שקט אוטומטי ומדויק לקטעי וידאו</li>
                    <li><span class="dot"></span>כתוביות AI אוטומטיות בעברית בלחיצת כפתור</li>
                    <li><span class="dot"></span>התקנה נקייה ומהירה — ללא הגדרות מסובכות</li>
                </ul>

                <div class="tip-card" id="warnPremiereOpen">
                    💡 <strong>טיפ ידידותי:</strong> Premiere Pro פועלת כעת ברקע. אין שום בעיה — רק זכרו לסגור ולפתוח אותה שוב לאחר סיום ההתקנה כדי שהתוסף יופיע.
                </div>

                <div class="error-card" id="errorCard"></div>
            </div>

            <div class="status-msg" id="statusMsg">מתקין את קבצי התוסף...</div>
            <div class="progress-bar" id="pBar">
                <div class="progress-fill" id="pFill"></div>
            </div>
        </div>

        <!-- Success Step -->
        <div class="content" id="stepSuccess" style="display: none;">
            <div class="success-box">
                <div class="success-title">🎉 איזה כיף! ההתקנה הושלמה בהצלחה!</div>
                <div class="success-desc">תוסף CS Trim מותקן ומוכן כעת לעבודה ב-Adobe Premiere Pro.</div>
                
                <div class="guide-box">
                    <div class="guide-step"><strong>1.</strong> פתחו (או הפעילו מחדש) את <strong>Adobe Premiere Pro</strong>.</div>
                    <div class="guide-step"><strong>2.</strong> בתפריט העליון בחרו:</div>
                    <div class="menu-path">Window &gt; Extensions &gt; CS Trim</div>
                    <div class="menu-hebrew-hint">(בעברית: חלון &gt; הרחבות &gt; CS Trim)</div>
                </div>
            </div>
        </div>

        <!-- Footer Buttons -->
        <div class="footer-btns" id="footerMain">
            <button class="btn btn-secondary" onclick="window.close();" id="btnCancel">ביטול</button>
            <button class="btn btn-primary" onclick="startInstall();" id="btnInstall">התקן עכשיו 🚀</button>
        </div>

        <div class="footer-btns" id="footerSuccess" style="display: none;">
            <button class="btn btn-primary" onclick="window.close();">סיום ✓</button>
        </div>
    </div>

    <script>
        function initApp() {
            try {
                window.resizeTo(540, 480);
                window.moveTo((screen.width - 540) / 2, (screen.height - 480) / 2);
            } catch(e) {}

            try {
                if (isPremiereRunning()) {
                    document.getElementById("warnPremiereOpen").style.display = "block";
                }
            } catch(e) {}
        }

        function isPremiereRunning() {
            try {
                var locator = new ActiveXObject("WbemScripting.SWbemLocator");
                var service = locator.ConnectServer(".", "root\\cimv2");
                var procs = service.ExecQuery("Select Name from Win32_Process Where Name = 'Adobe Premiere Pro.exe' or Name = 'Premiere.exe'");
                return (procs.Count > 0);
            } catch(e) {
                return false;
            }
        }

        function getBaseDirectory(fso, shell) {
            var p = window.location.pathname;
            if (p.charAt(0) === '/' || p.charAt(0) === '\\') {
                p = p.substring(1);
            }
            p = decodeURIComponent(p).replace(/\//g, "\\");

            var dir = "";
            try { dir = fso.GetParentFolderName(p); } catch(e) {}
            if (dir && fso.FolderExists(dir)) {
                return dir;
            }

            try {
                var cmd = CSTrimSetup.commandLine;
                cmd = cmd.replace(/^"/, "").replace(/"$/, "");
                var cmdDir = fso.GetParentFolderName(cmd);
                if (cmdDir && fso.FolderExists(cmdDir)) return cmdDir;
            } catch(e) {}

            return shell.CurrentDirectory;
        }

        function findSourceFolder(fso, baseDir) {
            // Check 1: subfolder com.autocut.panel
            var c1 = baseDir + "\\com.autocut.panel";
            if (fso.FolderExists(c1) && fso.FileExists(c1 + "\\CSXS\\manifest.xml")) {
                return c1;
            }

            // Check 2: baseDir has CSXS/manifest.xml
            if (fso.FileExists(baseDir + "\\CSXS\\manifest.xml")) {
                return baseDir;
            }

            // Check 3: parent dir has com.autocut.panel
            try {
                var parentDir = fso.GetParentFolderName(baseDir);
                var c3 = parentDir + "\\com.autocut.panel";
                if (fso.FolderExists(c3) && fso.FileExists(c3 + "\\CSXS\\manifest.xml")) {
                    return c3;
                }
            } catch(e) {}

            return null;
        }

        function createFolderRecursive(fso, folderPath) {
            if (fso.FolderExists(folderPath)) return;
            var parent = fso.GetParentFolderName(folderPath);
            if (parent && !fso.FolderExists(parent)) {
                createFolderRecursive(fso, parent);
            }
            try {
                fso.CreateFolder(folderPath);
            } catch(e) {}
        }

        function copyFilesClean(fso, srcDir, dstDir) {
            createFolderRecursive(fso, dstDir);
            var items = ["CSXS", "css", "host", "img", "js", "index.html", ".debug", "bin"];
            for (var i = 0; i < items.length; i++) {
                var item = items[i];
                var s = srcDir + "\\" + item;
                var d = dstDir + "\\" + item;
                if (fso.FolderExists(s)) {
                    if (fso.FolderExists(d)) {
                        try { fso.DeleteFolder(d, true); } catch(e) {}
                    }
                    try {
                        fso.CopyFolder(s, d, true);
                    } catch(e) {
                        try { fso.CopyFolder(s, d, true); } catch(err) {}
                    }
                } else if (fso.FileExists(s)) {
                    if (fso.FileExists(d)) {
                        try { fso.DeleteFile(d, true); } catch(e) {}
                    }
                    try {
                        fso.CopyFile(s, d, true);
                    } catch(e) {}
                }
            }
        }

        function startInstall() {
            var btnInstall = document.getElementById("btnInstall");
            var btnCancel = document.getElementById("btnCancel");
            var pBar = document.getElementById("pBar");
            var pFill = document.getElementById("pFill");
            var statusMsg = document.getElementById("statusMsg");
            var errorCard = document.getElementById("errorCard");

            errorCard.style.display = "none";
            btnInstall.disabled = true;
            btnCancel.disabled = true;
            pBar.style.display = "block";
            statusMsg.style.display = "block";
            statusMsg.innerText = "מאתר את קבצי התוסף...";
            pFill.style.width = "25%";

            setTimeout(function() {
                try {
                    var fso = new ActiveXObject("Scripting.FileSystemObject");
                    var shell = new ActiveXObject("WScript.Shell");

                    var baseDir = getBaseDirectory(fso, shell);
                    var srcDir = findSourceFolder(fso, baseDir);

                    if (!srcDir) {
                        throw new Error("לא נמצאה תיקיית התוסף com.autocut.panel. אם הורדתם קובץ ZIP, אנא ודאו שחילצתם את כל הקבצים לפני ההפעלה.");
                    }

                    statusMsg.innerText = "מעתיק קבצים לתיקיית התוספים של Premiere Pro...";
                    pFill.style.width = "60%";

                    // 1. User AppData (Always writable without admin rights)
                    var appData = shell.ExpandEnvironmentStrings("%APPDATA%");
                    var userTarget = appData + "\\Adobe\\CEP\\extensions\\com.autocut.panel";
                    copyFilesClean(fso, srcDir, userTarget);

                    // 2. Common Program Files (x86) - if available and writable
                    try {
                        var common86 = shell.ExpandEnvironmentStrings("%COMMONPROGRAMFILES(x86)%");
                        if (common86 && common86.indexOf("%") === -1) {
                            var sysTarget86 = common86 + "\\Adobe\\CEP\\extensions\\com.autocut.panel";
                            copyFilesClean(fso, srcDir, sysTarget86);
                        }
                    } catch(e) {}

                    // 3. Common Program Files (64-bit) - if available and writable
                    try {
                        var common = shell.ExpandEnvironmentStrings("%COMMONPROGRAMFILES%");
                        if (common && common.indexOf("%") === -1) {
                            var sysTarget = common + "\\Adobe\\CEP\\extensions\\com.autocut.panel";
                            copyFilesClean(fso, srcDir, sysTarget);
                        }
                    } catch(e) {}

                    statusMsg.innerText = "מפעיל תאימות ל-Premiere Pro...";
                    pFill.style.width = "85%";

                    // Write PlayerDebugMode for CSXS versions 7 through 20
                    for (var v = 7; v <= 20; v++) {
                        try {
                            shell.RegWrite("HKCU\\Software\\Adobe\\CSXS." + v + "\\PlayerDebugMode", "1", "REG_SZ");
                        } catch(e) {}
                        try {
                            shell.RegWrite("HKLM\\Software\\Adobe\\CSXS." + v + "\\PlayerDebugMode", "1", "REG_SZ");
                        } catch(e) {}
                        try {
                            shell.RegWrite("HKLM\\Software\\WOW6432Node\\Adobe\\CSXS." + v + "\\PlayerDebugMode", "1", "REG_SZ");
                        } catch(e) {}
                    }

                    pFill.style.width = "100%";
                    statusMsg.innerText = "ההתקנה הושלמה בהצלחה!";

                    setTimeout(function() {
                        document.getElementById("stepMain").style.display = "none";
                        document.getElementById("footerMain").style.display = "none";
                        document.getElementById("stepSuccess").style.display = "block";
                        document.getElementById("footerSuccess").style.display = "flex";
                    }, 400);

                } catch(e) {
                    errorCard.innerHTML = "<strong>שגיאה בהתקנה:</strong> " + e.message + "<br><br>אל דאגה! תוכלו להעתיק את תיקיית <code>com.autocut.panel</code> ידנית לתיקייה:<br><code>%APPDATA%\\Adobe\\CEP\\extensions\\</code>";
                    errorCard.style.display = "block";
                    btnInstall.disabled = false;
                    btnCancel.disabled = false;
                    pBar.style.display = "none";
                    statusMsg.style.display = "none";
                }
            }, 300);
        }
    </script>
</body>
</html>
